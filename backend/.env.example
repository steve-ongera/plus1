# Copy this file to .env and adjust.  cp .env.example .env

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite for quick local dev, PostgreSQL for production
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:pass@localhost:5432/plus1

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Leave empty in dev -> in-memory channel layer. Set in production:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Uploads
MAX_IMAGE_MB=5
MAX_VIDEO_MB=30

# Time-to-live
STATUS_TTL_HOURS=6
MOMENT_TTL_HOURS=24
LINKUP_TTL_HOURS=24
